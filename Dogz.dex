<style>
  .game-button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin: 20px auto;
  }

  .game-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 110px;
    padding: 10px 16px;
    border: none;
    border-radius: 12px;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    color: white;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 6px 16px rgba(0,0,0,0.22);
    transition: transform 0.12s ease, filter 0.12s ease;
  }

  .game-button:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
  }
</style>

<div class="game-button-row">
  <a class="game-button" href="/deltarune/">Deltarune</a>
  <a class="game-button" href="/basket-random/">Basket</a>
  <a class="game-button" href="/karlson/">Karlson</a>
  <a class="game-button" href="/diceamillion/">Dice</a>
